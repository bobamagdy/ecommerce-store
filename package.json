{
  "name": "ecommerce-store",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test && npm run build:prod",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "verify": "npm run config:generate && npm run format:check && npm run lint && npm run test:coverage && npm run build:prod && npm run e2e",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "config:generate": "node scripts/generate-primeui-license.mjs",
    "prestart": "npm run config:generate",
    "prelint": "npm run config:generate",
    "pretest": "npm run config:generate",
    "pretest:coverage": "npm run config:generate",
    "prebuild": "npm run config:generate",
    "prebuild:prod": "npm run config:generate"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/aria": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@primeicons/angular": "^8.0.0",
    "@primeuix/themes": "^3.0.0",
    "primeicons": "^8.0.0",
    "primeng": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.0.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.0"
  }
}
